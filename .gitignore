.lake
# Ignore compiled object files (never commit generated .o)
c/*.o

# Ignore any generated prebuilt artifacts; keep directory skeleton only
prebuilt/
!prebuilt/.gitkeep

# Lake build dirs
.build/
lake-packages/

# Lean artifacts
*.olean
*.trace
*.log

# Misc
.DS_Store
.idea/
.vscode/

# Ignore test certificates
WebSocket/Tests/certs/*

# Ignore local OpenSSL build (if any)
vendor/openssl/